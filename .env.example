# 1. SUPABASE POSTGRESQL CONNECTION POOLER (Supavisor Transaction Mode)
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL="postgresql://postgres.idhvqdcgzyaxdrkwcoxt:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. SUPABASE CLIENT CONFIGURATION (Browser-Safe Publishable Keys Only)
VITE_SUPABASE_URL="https://idhvqdcgzyaxdrkwcoxt.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_sJmA3MFox-h1Ax8IZ-RDHg_hkYzdBqB"
VITE_SUPABASE_STORAGE_BUCKET="product-images"

# 3. SUPABASE SERVER-SIDE ADMIN CONFIGURATION (Server-Only Secrets)
SUPABASE_URL="https://idhvqdcgzyaxdrkwcoxt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
